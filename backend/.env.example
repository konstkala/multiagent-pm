# Copy to backend/.env. Defaults match docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://pm:pm@localhost:5432/pm
LOG_LEVEL=INFO
# Google sign-in (optional). Redirect URI to register in Google Cloud Console:
#   http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...

# Needed only for real Claude calls (tests use fakes). Never commit the real key.
